{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Esquema de Trámite",
  "description": "Esquema de validación para archivos JSON de trámites en Trámite Claro",
  "type": "object",
  "required": ["id", "nombre", "categoria", "duracion_estimada", "dificultad", "descripcion_simple", "pasos"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Identificador único en kebab-case"
    },
    "nombre": {
      "type": "string",
      "minLength": 3,
      "description": "Nombre completo del trámite"
    },
    "categoria": {
      "type": "string",
      "enum": ["Internacional", "Nacional", "Vehicular", "Documentos Oficiales", "Fiscal", "Notarial", "Inmobiliario", "Bienestar Social"],
      "description": "Categoría del trámite"
    },
    "duracion_estimada": {
      "type": "string",
      "description": "Tiempo aproximado para completar el trámite"
    },
    "dificultad": {
      "type": "string",
      "enum": ["baja", "media", "alta"],
      "description": "Nivel de complejidad del trámite"
    },
    "costo_aproximado": {
      "type": "string",
      "description": "Costo aproximado en pesos mexicanos o dólares"
    },
    "descripcion_simple": {
      "type": "string",
      "minLength": 10,
      "description": "Descripción breve y clara del trámite"
    },
    "pasos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["numero", "titulo", "descripcion", "documentos_requeridos"],
        "properties": {
          "numero": {
            "type": "integer",
            "minimum": 1,
            "description": "Número de orden del paso"
          },
          "titulo": {
            "type": "string",
            "description": "Título breve del paso"
          },
          "descripcion": {
            "type": "string",
            "minLength": 20,
            "description": "Explicación detallada en lenguaje simple (nivel primaria)"
          },
          "tiempo_estimado": {
            "type": "string",
            "description": "Tiempo aproximado para completar este paso"
          },
          "consejos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Lista de consejos útiles para este paso"
          },
          "documentos_requeridos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["nombre", "tipo", "descripcion", "obligatorio"],
              "properties": {
                "nombre": {
                  "type": "string",
                  "description": "Nombre del documento"
                },
                "tipo": {
                  "type": "string",
                  "enum": ["original", "copia", "copia_certificada", "digital"],
                  "description": "Tipo de documento requerido"
                },
                "descripcion": {
                  "type": "string",
                  "description": "Explicación simple y detallada del documento"
                },
                "obligatorio": {
                  "type": "boolean",
                  "description": "Si el documento es obligatorio u opcional"
                },
                "cantidad": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1,
                  "description": "Número de copias necesarias"
                },
                "vigencia": {
                  "type": "string",
                  "description": "Requisitos de vigencia del documento"
                },
                "ejemplos": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Ejemplos concretos de este tipo de documento"
                }
              }
            }
          }
        }
      }
    },
    "checklist_completo": {
      "type": "object",
      "properties": {
        "documentos_obligatorios": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lista consolidada de todos los documentos obligatorios"
        },
        "documentos_opcionales": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lista de documentos opcionales que pueden ayudar"
        },
        "recomendaciones_generales": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Recomendaciones generales para todo el proceso"
        }
      }
    }
  }
}
